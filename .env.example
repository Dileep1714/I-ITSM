# Copy to .env (never commit .env) and fill in.
POSTGRES_PASSWORD=change-me-long-random-password
# 32+ random characters, e.g. from: openssl rand -base64 48
JWT_SECRET=change-me-at-least-32-random-characters-long
# The address people open, e.g. http://203.0.113.10 or https://iitsm.example.com
PUBLIC_URL=http://localhost
# true loads the demo accounts and services on first start
SEED_DEMO_DATA=true
# Optional: free key from https://aistudio.google.com (enables the AI copilot)
GEMINI_API_KEY=
